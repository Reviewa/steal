#!name=AppStore 限免面板
#!desc=显示 App Store 限免应用列表（本体限免 & 内购限免），数据来源酷酷API。在 appCount= 后修改显示条数，不填默认 8 条。
#!author=Hermes
#!homepage=https://github.com/7452323

[Panel]
AppStore限免 = script-name=AppStore_Free_Panel, update-interval=600

[Script]
AppStore_Free_Panel = type=panel, script-path=data:text/javascript;base64,, argument=appCount=8
